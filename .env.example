# Supabase → Project Settings → Data API (URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase secret key (for saving customer questions and photos).
SUPABASE_SECRET_KEY=

# Stripe → Developers → API keys. Use the test key (sk_test_...) until launch.
STRIPE_SECRET_KEY=

# The site's public address, used for Stripe's return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for local development without Supabase: path to the scraper's products.json
# LOCAL_PRODUCTS_JSON=../golden-star-scraper/data/products.json

# Optional spam check on the question form: Cloudflare → Turnstile → Add widget (free).
# Leave both empty to skip it (the form still has its built-in spam traps).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
